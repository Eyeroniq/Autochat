# Copy to .env and fill in. .env is git-ignored.

# --- Chat model: any OpenAI-compatible API ---------------------------------
# Groq:        https://api.groq.com/openai/v1
# Gemini:      https://generativelanguage.googleapis.com/v1beta/openai/
# OpenRouter:  https://openrouter.ai/api/v1   (see the models note in settings-lite.yaml)
OPENAI_API_BASE=https://api.groq.com/openai/v1
OPENAI_API_KEY=
# Optional: pin the default model by its id from the provider's /v1/models.
AUTOCHAT_LLM_DEFAULT=

# --- Access control (required) ---------------------------------------------
# python -c 'import base64; print("Basic " + base64.b64encode("user:password".encode()).decode())'
AUTOCHAT_AUTH_SECRET=

# --- Embeddings (runs in the ollama container) -----------------------------
# Change both together: nomic-embed-text=768, all-minilm=384, mxbai-embed-large=1024.
# Changing the model after ingesting documents requires re-ingesting them.
EMBEDDING_MODEL=nomic-embed-text
AUTOCHAT_EMBED_DIM=768

# --- Guest demo mode --------------------------------------------------------
# Visitors get a rate-limited guest session without the secret above.
AUTOCHAT_GUEST_ENABLED=true
AUTOCHAT_GUEST_MESSAGES_PER_SESSION=20
# Caps Groq usage across all guests per UTC day.
AUTOCHAT_GUEST_DAILY_MESSAGE_LIMIT=300
# Behind Caddy every request comes from Caddy's IP, so per-visitor limits need
# the X-Forwarded-For header. Safe while AUTOCHAT_BIND=127.0.0.1 (Caddy is the only
# way in); set to false if you expose port 8080 directly.
AUTOCHAT_GUEST_TRUST_FORWARDED_FOR=true

# --- Hosting ----------------------------------------------------------------
# Public domain for `docker compose --profile https up -d`.
DOMAIN=
# 127.0.0.1 keeps port 8080 private (behind Caddy); 0.0.0.0 exposes it directly.
AUTOCHAT_BIND=127.0.0.1
# Host port for AutoChat; change it if something else already uses 8080.
AUTOCHAT_PORT=8080

# --- Code execution (owner only; guests can never use it) -------------------
# Off for a public demo. Set the provider to "local" and the flags to true to
# enable. The code cannot see the API keys or the owner secret.
AUTOCHAT_CODE_EXECUTION_PROVIDER=
AUTOCHAT_CODE_EXECUTION_TOOLS_BASH_ENABLED=false
AUTOCHAT_CODE_EXECUTION_TOOLS_TEXT_EDITOR_ENABLED=false
AUTOCHAT_CODE_EXECUTION_TOOLS_PRESENT_FILES_ENABLED=false
